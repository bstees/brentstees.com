{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brentstees-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the worker first so www requests hit the redirect before static files.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "brentstees.com", "custom_domain": true },
    { "pattern": "www.brentstees.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
