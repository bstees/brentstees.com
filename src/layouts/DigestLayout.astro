---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import '../styles/digest.css';
import { links } from '../data/site';

type Props = {
  title: string;
  description: string;
  canonicalPath: string;
  publicationDate?: Date;
  topics?: string[];
  pageType?: 'website' | 'article';
};

const {
  title,
  description,
  canonicalPath,
  publicationDate,
  topics = [],
  pageType = 'website',
} = Astro.props;
const site = Astro.site ?? new URL('https://brentstees.com');
const canonical = new URL(canonicalPath, site);
const socialTitle = title.includes('Brent Stees') ? title : `${title} · Brent Stees`;
const jsonLd = pageType === 'article' && publicationDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: publicationDate.toISOString().slice(0, 10),
      dateModified: publicationDate.toISOString().slice(0, 10),
      mainEntityOfPage: canonical.href,
      author: { '@type': 'Person', name: 'Brent Stees', url: site.href },
      publisher: { '@type': 'Person', name: 'Brent Stees', url: site.href },
      keywords: topics,
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{socialTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Friday AI Engineering Brief" href="/digest/rss.xml" />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', site)} />
    {publicationDate && <meta property="article:published_time" content={publicationDate.toISOString().slice(0, 10)} />}
    {topics.map((topic) => <meta property="article:tag" content={topic} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
      } catch {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="digest-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="spotlight" aria-hidden="true"></div>

    <header class="digest-masthead">
      <a class="digest-home" href="/">
        <span class="digest-mark" aria-hidden="true"></span>
        <span><strong>Brent Stees</strong><small class="mono">AI engineering notes</small></span>
      </a>
      <nav aria-label="Digest navigation">
        <a href="/digest/">All issues</a>
        <a href="/digest/rss.xml">RSS</a>
      </nav>
      <ul class="profiles digest-profiles" aria-label="Profiles">
        <li><a href={links.github}>GitHub</a></li>
        <li><a href={links.linkedin}>LinkedIn</a></li>
        <li><a href={links.codepen}>CodePen</a></li>
      </ul>
      <fieldset class="theme digest-theme">
        <legend class="sr-only">Color theme</legend>
        {['auto', 'light', 'dark'].map((theme) => (
          <>
            <input type="radio" name="theme" id={`theme-${theme}`} value={theme} checked={theme === 'auto'} />
            <label for={`theme-${theme}`} class="mono">{theme}</label>
          </>
        ))}
      </fieldset>
    </header>

    <main id="main" class="digest-main">
      <slot />
    </main>

    <footer class="digest-footer mono muted">
      <p>Research notes on AI-assisted software delivery, verification, and engineering systems.</p>
      <p><a href="/">← brentstees.com</a> · <a href="/digest/index.json">JSON index</a> · <a href="/digest/sitemap.xml">Sitemap</a></p>
    </footer>

    <script is:inline>
      const themeInputs = document.querySelectorAll('input[name="theme"]');
      let activeTheme = 'auto';
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') activeTheme = savedTheme;
      } catch {}
      for (const input of themeInputs) {
        input.checked = input.value === activeTheme;
        input.addEventListener('change', () => {
          const value = input.value;
          if (value === 'auto') {
            delete document.documentElement.dataset.theme;
            localStorage.removeItem('theme');
          } else {
            document.documentElement.dataset.theme = value;
            localStorage.setItem('theme', value);
          }
        });
      }
    </script>
  </body>
</html>
