---
import DigestLayout from '../layouts/DigestLayout.astro';
---

<DigestLayout
  title="Page not found"
  description="That page doesn't exist on brentstees.com."
  canonicalPath="/404"
  noindex
>
  <header class="digest-hero">
    <p class="kicker mono">404 · Not found</p>
    <h1>That page isn't here.</h1>
    <p class="digest-deck">The link may be old or mistyped. These will get you somewhere real.</p>
    <p class="cta-row">
      <a class="button" href="/">Go to the homepage <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/digest/">Read the AI engineering brief</a>
    </p>
  </header>
</DigestLayout>
