---
import { getCollection } from 'astro:content';
import DigestCard from '../../../components/DigestCard.astro';
import DigestLayout from '../../../layouts/DigestLayout.astro';

export async function getStaticPaths() {
  const issues = await getCollection('digests');
  const topics = [...new Set(issues.flatMap((issue) => issue.data.topics))];
  return topics.map((topic) => ({ params: { topic }, props: { topic } }));
}

const { topic } = Astro.props as { topic: string };
const issues = (await getCollection('digests'))
  .filter((issue) => issue.data.topics.includes(topic))
  .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf());
const label = topic.replaceAll('-', ' ');
---

<DigestLayout
  title={`${label} · Friday AI Engineering Brief`}
  description={`Friday AI Engineering Brief issues about ${label}.`}
  canonicalPath={`/digest/topic/${topic}/`}
>
  <header class="digest-topic-hero">
    <nuk-breadcrumbs class="digest-crumbs mono">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/digest/">AI engineering brief</a></li>
        <li aria-current="page"><span class="digest-crumb-topic">{label}</span></li>
      </ol>
    </nuk-breadcrumbs>
    <p class="kicker mono">Topic index</p>
    <h1>{label}</h1>
    <p class="digest-deck">{issues.length} {issues.length === 1 ? 'issue' : 'issues'} in the research archive.</p>
  </header>
  <div class="digest-grid">
    {issues.map((entry) => <DigestCard entry={entry} />)}
  </div>
</DigestLayout>

