---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DigestLayout from '../../layouts/DigestLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('digests')).sort(
    (a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf(),
  );
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: entries[index - 1] ?? null,
      older: entries[index + 1] ?? null,
    },
  }));
}

type Props = {
  entry: CollectionEntry<'digests'>;
  newer: CollectionEntry<'digests'> | null;
  older: CollectionEntry<'digests'> | null;
};

const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
// Numbered findings ("1. Title") become the issue's scroll-spy nav, matching the homepage rail.
const numbered = headings.filter((h) => (h.depth === 2 || h.depth === 3) && /^\d+\.\s/.test(h.text));
const itemDepth = Math.min(...numbered.map((h) => h.depth));
const items = numbered
  .filter((h) => h.depth === itemDepth)
  .map((h) => ({
    slug: h.slug,
    num: h.text.match(/^(\d+)\./)![1].padStart(2, '0'),
    label: h.text.replace(/^\d+\.\s*/, ''),
  }));
const dateIso = entry.data.publicationDate.toISOString().slice(0, 10);
const dateLabel = entry.data.publicationDate.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<DigestLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/digest/${entry.id}/`}
  publicationDate={entry.data.publicationDate}
  topics={entry.data.topics}
  pageType="article"
>
  <article class="digest-issue">
    <header class="digest-issue-head">
      <a class="digest-back mono" href="/digest/">← All issues</a>
      <p class="kicker mono">Issue {String(entry.data.issueNumber).padStart(2, '0')}</p>
      <h1>{entry.data.title}</h1>
      <p class="digest-deck">{entry.data.description}</p>
      <div class="digest-byline">
        <time datetime={dateIso}>{dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>{entry.data.findingIds.length} research findings</span>
      </div>
      <ul class="digest-topic-list" aria-label="Topics">
        {entry.data.topics.map((topic) => (
          <li><a href={`/digest/topic/${topic}/`}>{topic.replaceAll('-', ' ')}</a></li>
        ))}
      </ul>
    </header>

    <div class="digest-provenance mono">
      <strong>Archive note</strong>
      <span>Originally issued {dateLabel}. Edited for web formatting, direct primary-source links, and clearly documented source corrections.</span>
    </div>

    <div class:list={['digest-issue-body', { 'has-toc': items.length > 1 }]}>
      {items.length > 1 && (
        <nav class="toc digest-toc" aria-label="Findings in this issue">
          <p class="kicker mono">In this issue</p>
          <ol>
            {items.map((item) => (
              <li><a href={`#${item.slug}`}><span class="mono">{item.num}</span><span class="bar" aria-hidden="true"></span><span class="label">{item.label}</span></a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="digest-prose">
        <Content />
      </div>
    </div>
  </article>

  <nav class="digest-pager" aria-label="Issue navigation">
    {older
      ? <a href={`/digest/${older.id}/`}><small class="mono">Previous issue</small><span>{older.data.title}</span></a>
      : <span></span>}
    {newer
      ? <a class="digest-pager-next" href={`/digest/${newer.id}/`}><small class="mono">Next issue</small><span>{newer.data.title}</span></a>
      : <span></span>}
  </nav>
</DigestLayout>

<script>
  // Scroll-spy for the findings nav: same behavior as the homepage rail.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.digest-toc a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
  );
  if (links.size && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a, id) => a.setAttribute('aria-current', String(id === e.target.id)));
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) spy.observe(el);
    });
  }
</script>
