---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { links, projects, capabilities, principles, kb, suggestions, features } from '../data/site';

const title = 'Brent Stees · Agentic Product & Automation Engineer';
const description =
  'Engineering leader scaling web products through creative direction, CSS and UX architecture, and agentic automation.';
const allNav = [
  ['console', 'Console'],
  ['about', 'About'],
  ['work', 'Work'],
  ['brief', 'Brief'],
  ['capabilities', 'Capabilities'],
  ['contact', 'Contact'],
];
const nav = allNav.filter(
  ([id]) => (id !== 'console' || features.console) && (id !== 'brief' || features.brief),
);
const num = (id: string) => String(nav.findIndex(([n]) => n === id) + 1).padStart(2, '0');
const latestBrief = (await getCollection('digests')).sort(
  (a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf(),
)[0];
const briefDate = latestBrief?.data.publicationDate.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const byId = (p: (typeof projects)[number]) => Object.fromEntries(p.nodes.map((n) => [n.id, n]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://brentstees.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://brentstees.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://brentstees.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="spotlight" aria-hidden="true"></div>

    <div class="shell">
      <header class="rail">
        <div class="rail-top">
          <p class="eyebrow mono"><span class="pulse" aria-hidden="true"></span>Agentic Product &amp; Automation Engineer</p>
          <h1>Brent Stees</h1>
          <p class="statement">
            Engineering leader scaling web products through <em>creative direction</em> and <em>agentic automation</em>.
          </p>

          <fieldset class="lens" aria-describedby="lens-hint">
            <legend class="mono">Read this page as</legend>
            <div class="seg">
              <input type="radio" name="lens" id="lens-lead" value="lead" />
              <label for="lens-lead">Leader</label>
              <input type="radio" name="lens" id="lens-build" value="build" checked />
              <label for="lens-build">Builder</label>
            </div>
            <p id="lens-hint" class="lens-hint">
              <span data-lens="lead">Strategy, teams, and creative direction.</span>
              <span data-lens="build">Architecture, automation stack, and evals.</span>
            </p>
          </fieldset>
          <script is:inline>
            {/* Apply ?lens= before content paints, so shared links open in the right mode. */}
            try {
              const l = new URLSearchParams(location.search).get('lens');
              if (l === 'lead' || l === 'build') document.getElementById('lens-' + l).checked = true;
            } catch {}
          </script>

          <nav class="toc" aria-label="Sections">
            <ol>
              {nav.map(([id, label], i) => (
                <li><a href={`#${id}`}><span class="mono">0{i + 1}</span><span class="bar" aria-hidden="true"></span>{label}</a></li>
              ))}
            </ol>
          </nav>
        </div>

        <div class="rail-foot">
          <ul class="profiles" aria-label="Profiles">
            <li><a href={links.github}>GitHub</a></li>
            <li><a href={links.linkedin}>LinkedIn</a></li>
            <li><a href={links.codepen}>CodePen</a></li>
          </ul>
          <fieldset class="theme">
            <legend class="sr-only">Color theme</legend>
            {['auto', 'light', 'dark'].map((t) => (
              <>
                <input type="radio" name="theme" id={`theme-${t}`} value={t} checked={t === 'auto'} />
                <label for={`theme-${t}`} class="mono">{t}</label>
              </>
            ))}
          </fieldset>
        </div>
      </header>

      <main id="main">
        <!-- 01 Console ------------------------------------------------------>
        {features.console && (
        <section id="console" aria-labelledby="console-title">
          <h2 class="kicker mono" id="console-title">{num('console')} · Ask the agent</h2>
          <div class="console" data-console>
            <form class="console-ask" data-form>
              <label for="q" class="sr-only">Ask a question about Brent</label>
              <span class="prompt mono" aria-hidden="true">›</span>
              <input id="q" name="q" type="text" autocomplete="off" placeholder="Ask about Brent's work, leadership, or stack…" maxlength="160" />
              <button type="submit" class="mono">Run</button>
            </form>
            <ul class="chips" aria-label="Suggested questions">
              {suggestions.map((s) => <li><button type="button" data-ask={s}>{s}</button></li>)}
            </ul>
            <ol class="trace mono" data-trace aria-label="Agent steps"></ol>
            <div class="answer" data-answer aria-live="polite">
              <p class="answer-idle">Pick a question or type your own. Each run shows its steps: parse, retrieve, rank, compose.</p>
            </div>
            <p class="console-note mono">Local retrieval over this page · no LLM · no network</p>
          </div>
        </section>
        )}

        <!-- 02 About -------------------------------------------------------->
        <section id="about" aria-labelledby="about-title">
          <h2 class="kicker mono" id="about-title">{num('about')} · About</h2>
          <div class="prose">
            <p class="lede" data-lens="lead">
              I've spent my career leading software teams and directing the craft of what they ship. I've designed, built,
              and shipped hundreds of sites, and I keep making complex systems clearer for the people who build and use them.
            </p>
            <p class="lede" data-lens="build">
              I'm an engineering manager who retooled as a hands-on agentic product and automation engineer. Today I build
              the agents, pipelines, and interfaces that let web apps scale, and I still write the CSS myself.
            </p>
            <p data-lens="lead">
              Lately the work is about operating models for human-and-agent teams: where AI accelerates delivery, where
              humans must decide, and how to make that boundary explicit, reviewable, and repeatable.
            </p>
            <p data-lens="build">
              My public work leans on explicit contracts: MCP tools, versioned asset sync, deterministic indexes, and
              evaluation harnesses for agent instructions. If an agent workflow can't be observed and tested, it isn't
              finished.
            </p>
            <ol class="principles">
              {principles.map(([t, d], i) => (
                <li><span class="mono">0{i + 1}</span><div><h3>{t}</h3><p>{d}</p></div></li>
              ))}
            </ol>
          </div>
        </section>

        <!-- 03 Work --------------------------------------------------------->
        <section id="work" aria-labelledby="work-title">
          <h2 class="kicker mono" id="work-title">{num('work')} · Selected work</h2>
          {projects.map((p) => {
            const n = byId(p);
            return (
              <article class="project" id={p.id} aria-labelledby={`${p.id}-t`}>
                <header class="project-head">
                  <p class="mono muted">{p.index} · {p.kind}</p>
                  <h3 id={`${p.id}-t`}><a href={p.href}>{p.title}<span class="arrow" aria-hidden="true">↗</span></a></h3>
                </header>
                <p>{p.summary}</p>
                <p class="lens-copy" data-lens="lead"><strong class="mono">Why it matters</strong>{p.lead}</p>
                <p class="lens-copy" data-lens="build"><strong class="mono">How it works</strong>{p.build}</p>

                <figure class="map" data-map>
                  <figcaption class="mono muted">System map: select a node</figcaption>
                  <div class="map-canvas">
                    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                      {p.edges.map(([a, b]) => (
                        <line class="edge" data-from={a} data-to={b} x1={n[a].x} y1={n[a].y} x2={n[b].x} y2={n[b].y} />
                      ))}
                    </svg>
                    {p.nodes.map((node) => (
                      <button
                        type="button"
                        class:list={['node', { hub: node.hub }]}
                        style={`--x:${node.x};--y:${node.y}`}
                        data-node={node.id}
                        data-detail={node.detail}
                        aria-pressed={node.hub ? 'true' : 'false'}
                      >{node.label}</button>
                    ))}
                  </div>
                  <p class="map-detail" aria-live="polite" data-detail-out>
                    <strong>{p.nodes.find((x) => x.hub)!.label}</strong> {p.nodes.find((x) => x.hub)!.detail}
                  </p>
                </figure>

                <ul class="tags mono" aria-label={`${p.title} stack`}>{p.stack.map((s) => <li>{s}</li>)}</ul>
              </article>
            );
          })}
        </section>

        <!-- AI engineering brief ------------------------------------------>
        {features.brief && (
        <section id="brief" aria-labelledby="brief-title">
          <h2 class="kicker mono" id="brief-title">{num('brief')} · AI engineering brief</h2>
          <p class="cta-line">Weekly field notes on building software with AI.</p>
          <p class="muted">
            Research on AI-assisted delivery, agentic workflows, verification, and engineering systems. What changed,
            why it matters, and what to do about it.
          </p>
          {latestBrief && (
            <article class="brief-latest" aria-labelledby="brief-latest-t">
              <p class="mono muted">
                Latest · Issue {String(latestBrief.data.issueNumber).padStart(2, '0')} ·{' '}
                <time datetime={latestBrief.data.publicationDate.toISOString().slice(0, 10)}>{briefDate}</time>
              </p>
              <h3 id="brief-latest-t"><a href={`/digest/${latestBrief.id}/`}>{latestBrief.data.title}</a></h3>
              <p>{latestBrief.data.description}</p>
            </article>
          )}
          <p class="cta-row">
            <a class="button" href="/digest/">Read the brief <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/digest/rss.xml">RSS feed</a>
          </p>
        </section>
        )}

        <!-- 04 Capabilities ------------------------------------------------->
        <section id="capabilities" aria-labelledby="cap-title">
          <h2 class="kicker mono" id="cap-title">{num('capabilities')} · Capabilities</h2>
          <ol class="caps">
            {capabilities.map((c, i) => (
              <li>
                <span class="mono muted">0{i + 1}</span>
                <h3>{c.title}</h3>
                <p data-lens="lead">{c.lead}</p>
                <p data-lens="build">{c.build}</p>
              </li>
            ))}
          </ol>
        </section>

        <!-- 05 Contact ------------------------------------------------------>
        <section id="contact" aria-labelledby="contact-title">
          <h2 class="kicker mono" id="contact-title">{num('contact')} · Contact</h2>
          <p class="cta-line">Have a complex system to make clearer, or a workflow worth automating?</p>
          <p class="muted">
            I'm open to conversations about agentic product engineering, AI-native development, developer experience,
            and hands-on product systems work.
          </p>
          <p class="cta-row">
            <a class="button" href={links.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a>
            {links.email && <a class="text-link" href={`mailto:${links.email}`}>{links.email}</a>}
          </p>
        </section>

        <footer class="foot mono muted">
          <p>Built from scratch with Astro and vanilla CSS. Zero client framework.</p>
          {features.brief && <p><a href="/digest/">AI engineering brief</a> · <a href="/digest/rss.xml">RSS</a></p>}
          <p>© {new Date().getFullYear()} Brent Stees</p>
        </footer>
      </main>
    </div>

    {features.console && <script type="application/json" id="kb" set:html={JSON.stringify(kb)} />}
    <script src="../scripts/main.ts"></script>
  </body>
</html>
