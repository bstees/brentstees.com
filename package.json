{
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.8"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate:digests": "node scripts/validate-digests.mjs",
    "build": "npm run validate:digests && astro build",
    "verify:digests": "npm run build && node scripts/verify-digest-build.mjs",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "test:browser": "npm run build && playwright test",
    "test:live": "BASE_URL=https://brentstees.com playwright test",
    "brief:new": "node scripts/brief/new-issue.mjs"
  },
  "name": "brentstees-com",
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.160.0"
  }
}
